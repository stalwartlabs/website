---
const tenants = [
  { letter: "A", name: "Acme Corp", domain: "acme.com · 3 domains", disk: 61, diskLabel: "61% · 122 GB / 200 GB", users: 60, usersLabel: "300 / 500 users", idp: "LDAP" },
  { letter: "F", name: "Foobar Industries", domain: "foobar.org · 1 domain", disk: 24, diskLabel: "24% · 47 GB / 200 GB", users: 34, usersLabel: "120 / 350 users", idp: "OIDC" },
  { letter: "I", name: "Initech Software", domain: "initech.io · 2 domains", disk: 89, diskLabel: "89% · 89 GB / 100 GB", users: 44, usersLabel: "88 / 200 users", idp: "internal", warn: true },
];
---
<div class="ten" role="img" aria-label="Per-tenant quotas and identity backends. Acme Corp (acme.com, 3 domains): 122 GB of 200 GB disk, 300 of 500 users, LDAP. Foobar Industries (foobar.org, 1 domain): 47 GB of 200 GB, 120 of 350 users, OIDC. Initech Software (initech.io, 2 domains): 89 GB of 100 GB, 88 of 200 users, internal directory.">
  <div class="head" aria-hidden="true">
    <span>Tenant</span>
    <span>Disk quota</span>
    <span>Principals</span>
    <span>IdP</span>
  </div>
  <ul class="rows">
    {tenants.map((t) => (
      <li class:list={["row", { "is-warn": t.warn }]}>
        <div class="who">
          <span class="avatar">{t.letter}</span>
          <span class="txt"><strong>{t.name}</strong><span class="v">{t.domain}</span></span>
        </div>
        <div class="meter meter--disk">
          <span class="bar"><span style={`width: ${t.disk}%`}></span></span>
          <span class="v">{t.diskLabel}</span>
        </div>
        <div class="meter">
          <span class="bar"><span style={`width: ${t.users}%`}></span></span>
          <span class="v">{t.usersLabel}</span>
        </div>
        <span class="idp">{t.idp}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .ten {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    container-type: inline-size;
  }

  .head {
    display: none;
    padding: 0 16px;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 650;
    color: var(--dim);
  }

  .rows {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: none;
    gap: 12px;
    padding: 14px 16px;
    border-radius: var(--r-lg);
    background: var(--tile);
    box-shadow: var(--shadow-tile);
  }

  .who {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    padding-right: 72px;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 11px;
    background: var(--sand);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 750;
    color: var(--text);
  }

  .txt {
    display: grid;
    gap: 1px;
    min-width: 0;
  }

  strong {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 680;
    line-height: 1.3;
    color: var(--text);
  }

  .v {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted);
  }


  .meter {
    display: grid;
    align-content: center;
    gap: 6px;
    min-width: 0;
  }

  .bar {
    display: block;
    height: 7px;
    overflow: hidden;
    border-radius: var(--r-pill);
    background: var(--sand);
  }

  .bar > span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--muted);
  }

  .row {
    position: relative;
  }

  .idp {
    position: absolute;
    top: 18px;
    right: 16px;
    padding: 3px 11px;
    border-radius: var(--r-pill);
    background: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--on-ink);
  }

  .is-warn .meter--disk .bar > span {
    background: var(--brand);
  }

  .is-warn .meter--disk .v {
    font-weight: 700;
    color: var(--brand-text);
  }

  .is-warn .avatar {
    background: var(--rose);
    color: var(--brand-text);
  }

  @container (min-width: 420px) and (max-width: 599px) {
    .row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .who {
      grid-column: 1 / -1;
    }
  }

  @container (min-width: 600px) {
    .head,
    .row {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) minmax(0, 0.8fr) 4.6rem;
      grid-template-areas: none;
      align-items: center;
      gap: 16px;
    }

    .who {
      padding-right: 0;
    }

    .idp {
      position: static;
      justify-self: start;
    }
  }
</style>
