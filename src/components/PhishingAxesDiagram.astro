---
import Icon from "./Icon.astro";

const lanes = [
  { icon: "link", name: "Homograph URL", eg: "paypaр.com (Cyrillic 'р')" },
  { icon: "user-round-x", name: "Sender spoof", eg: 'From: "CEO <ceo@ceo-secure.com>"' },
  { icon: "globe", name: "Lookalike domain", eg: "chase-banking.example.com" },
];
---
<div class="phi" role="img" aria-label="Phishing detection axes: homograph URLs (paypaр.com with a Cyrillic р), sender spoofing (From: CEO <ceo@ceo-secure.com>) and lookalike domains (chase-banking.example.com) each add to a combined phishing score, here +4.7, suspected. A trusted reply, recognised as a real reply thread, subtracts from the score.">
  <span class="dg-caption">Phishing, structurally</span>
  <div class="grid">
    <ul class="lanes">
      {lanes.map((l) => (
        <li class="lane">
          <span class="ic"><Icon name={l.icon} size={16} /></span>
          <span class="txt"><strong>{l.name}</strong><span class="v">{l.eg}</span></span>
          <span class="sign"><Icon name="plus" size={13} /></span>
        </li>
      ))}
      <li class="lane lane--good">
        <span class="ic"><Icon name="reply" size={16} /></span>
        <span class="txt"><strong>Trusted reply</strong><span class="v">recognises a real reply thread</span></span>
        <span class="sign"><Icon name="minus" size={13} /></span>
      </li>
    </ul>
    <div class="score">
      <span class="badge-ic"><Icon name="shield-alert" size={18} /></span>
      <span class="label">Phishing score</span>
      <span class="num">+4.7</span>
      <span class="verdict">SUSPECTED</span>
      <span class="note"><Icon name="minus" size={12} />trusted reply subtracts from score</span>
    </div>
  </div>
</div>

<style>
  .phi {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    container-type: inline-size;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
  }

  .lanes {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lane {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px 10px 10px;
    border-radius: var(--r-lg);
    background: var(--tile);
    box-shadow: var(--shadow-tile);
  }

  .lane--good {
    background: transparent;
    box-shadow: none;
    border: 1.5px dashed color-mix(in srgb, var(--dim) 50%, transparent);
  }

  .ic {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: none;
    border-radius: 10px;
    background: var(--sand);
    color: var(--text);
  }

  .lane--good .ic {
    background: var(--tile);
  }

  .txt {
    display: grid;
    gap: 1px;
    min-width: 0;
    flex: 1;
  }

  strong {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 680;
    line-height: 1.3;
    color: var(--text);
  }

  .v {
    overflow-wrap: anywhere;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .sign {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    flex: none;
    border-radius: 50%;
    background: var(--rose);
    color: var(--brand-text);
  }

  .lane--good .sign {
    background: var(--tile);
    color: var(--text);
  }

  .score {
    display: grid;
    justify-items: start;
    align-content: center;
    gap: 4px;
    padding: 18px;
    border-radius: var(--r-lg);
    background: var(--rose);
  }

  .badge-ic {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    margin-bottom: 6px;
    border-radius: 12px;
    background: var(--brand);
    color: #fff;
  }

  .label {
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 650;
    color: var(--brand-text);
  }

  .num {
    font-family: var(--font-mono);
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--brand-text);
  }

  .verdict {
    padding: 2px 10px;
    border-radius: var(--r-pill);
    background: var(--brand);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #fff;
  }

  .note {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .note :global(svg) {
    flex: none;
  }

  @container (min-width: 520px) {
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(150px, 0.5fr);
    }
  }
</style>
