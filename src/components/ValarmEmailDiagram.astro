---
import Icon from "./Icon.astro";
---
<div class="dg" role="img" aria-label="Email reminder path: a VEVENT, Quarterly review starting 2026-05-20 10:00 UTC, carries a VALARM with TRIGGER -PT15M, ACTION EMAIL and ATTENDEE bob@example.com. The Stalwart scheduler and MTA fire it and send the reminder over SMTP: Reminder: Quarterly review, starts in 15 minutes.">
  <span class="dg-caption">Reminder fires from the server</span>
  <div class="flow">
    <div class="event">
      <span class="tag">VEVENT</span>
      <dl>
        <dt>SUMMARY:</dt><dd>Quarterly review</dd>
        <dt>DTSTART:</dt><dd>2026-05-20 10:00 UTC</dd>
      </dl>
      <div class="alarm">
        <span class="tag is-brand">VALARM</span>
        <dl>
          <dt>TRIGGER:</dt><dd>-PT15M</dd>
          <dt>ACTION:</dt><dd class="hot">EMAIL</dd>
          <dt>ATTENDEE:</dt><dd>bob@example.com</dd>
        </dl>
      </div>
    </div>
    <span class="arrow a1"><Icon name="arrow-right" size={16} /></span>
    <div class="server">
      <span class="ic"><Icon name="bell-ring" size={18} /></span>
      <strong>Stalwart</strong>
      <span>scheduler + MTA</span>
    </div>
    <div class="hop">
      <span class="arrow"><Icon name="arrow-right" size={16} /></span>
      <span class="proto">SMTP</span>
    </div>
    <div class="mail">
      <span class="ic"><Icon name="mail" size={18} /></span>
      <strong>Reminder: Quarterly review</strong>
      <span>starts in 15 minutes</span>
    </div>
  </div>
</div>

<style>
  .dg {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    container-type: inline-size;
  }
  .flow {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 10px;
  }
  .event,
  .server,
  .mail {
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 16px;
    border-radius: var(--r-lg);
    background: var(--tile);
    box-shadow: var(--shadow-tile);
  }
  .event {
    gap: 12px;
  }
  .server {
    background: var(--rose);
    box-shadow: none;
  }
  strong {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 680;
    line-height: 1.3;
  }
  .server > span:not(.ic),
  .mail > span:not(.ic) {
    color: var(--muted);
    font-size: var(--fs-xs);
    line-height: 1.45;
  }
  .ic {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: 8px;
    border-radius: 12px;
    background: var(--rose);
    color: var(--brand-text);
  }
  .server .ic {
    background: var(--brand);
    color: #fff;
  }
  .tag {
    justify-self: start;
    padding: 2px 10px;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--on-ink);
    box-shadow: inset 0 0 0 1px var(--ink-edge);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
  }
  .tag.is-brand {
    background: var(--brand);
    color: #fff;
    box-shadow: none;
  }
  dl {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 4px 8px;
    font-family: var(--font-mono);
    font-size: 0.71875rem;
    line-height: 1.5;
  }
  dt {
    color: var(--dim);
  }
  dd {
    margin: 0;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .hot {
    color: var(--brand-text);
    font-weight: 700;
  }
  .alarm {
    display: grid;
    gap: 8px;
    padding: 12px;
    border-radius: 14px;
    background: var(--rose);
  }
  .arrow {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--tile);
    color: var(--brand-text);
    box-shadow: var(--shadow-tile);
  }
  .hop {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .proto {
    padding: 2px 8px;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--on-ink);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
  }
  @container (max-width: 680px) {
    .flow {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    }
    .event {
      grid-column: 1 / -1;
    }
    .a1 {
      grid-column: 1 / -1;
      justify-self: center;
      transform: rotate(90deg);
    }
  }
  @container (max-width: 400px) {
    .flow {
      grid-template-columns: minmax(0, 1fr);
      justify-items: stretch;
    }
    .arrow {
      transform: rotate(90deg);
    }
    .hop {
      flex-direction: row;
      justify-self: center;
    }
    .a1 {
      justify-self: center;
    }
  }
</style>
