---
import Icon from "./Icon.astro";

const paths = [
  { out: "iTIP", icon: "calendar", name: "Internal CalDAV peer (Bob)", sub: "iTIP: REQUEST → REPLY" },
  { out: "iMIP via SMTP", icon: "mail", name: "External attendee (Carol)", sub: "iMIP: SMTP delivery" },
];
---
<div class="dg" role="img" aria-label="Scheduling flow: the organiser, Alice, creates a VEVENT and hands it to the Stalwart scheduler (CalDAV and JMAP for Calendars). The scheduler sends it over iTIP to an internal CalDAV peer, Bob, and as iMIP via SMTP to an external attendee, Carol. Both REPLY back to the scheduler.">
  <span class="dg-caption">One scheduler, two delivery paths</span>
  <div class="node">
    <span class="ic"><Icon name="user-round" size={18} /></span>
    <div><strong>Organiser (Alice)</strong><span>creates VEVENT</span></div>
  </div>
  <div class="link">
    <span class="arrow"><Icon name="arrow-down" size={14} /></span>
    <span class="chip">VEVENT</span>
  </div>
  <div class="node is-brand">
    <span class="ic"><Icon name="calendar-sync" size={18} /></span>
    <div><strong>Stalwart scheduler</strong><span>CalDAV + JMAP for Calendars</span></div>
  </div>
  <div class="split">
    {paths.map((p) => (
      <div class="path">
        <div class="link">
          <span class="arrow"><Icon name="arrow-down" size={14} /></span>
          <span class="chip is-out">{p.out}</span>
          <span class="arrow is-back"><Icon name="arrow-up" size={14} /></span>
          <span class="chip is-back">REPLY</span>
        </div>
        <div class="node">
          <span class="ic"><Icon name={p.icon} size={18} /></span>
          <div><strong>{p.name}</strong><span>{p.sub}</span></div>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .dg {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    container-type: inline-size;
  }
  .dg-caption {
    margin-bottom: 6px;
  }
  .node {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px;
    border-radius: var(--r-lg);
    background: var(--tile);
    box-shadow: var(--shadow-tile);
  }
  .node div {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  strong {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 680;
    line-height: 1.3;
  }
  .node span:not(.ic) {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.71875rem;
    line-height: 1.45;
  }
  .ic {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 12px;
    background: var(--rose);
    color: var(--brand-text);
  }
  .is-brand {
    background: var(--rose);
    box-shadow: none;
  }
  .is-brand .ic {
    background: var(--brand);
    color: #fff;
  }
  .link {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 2px 0;
  }
  .arrow {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--tile);
    color: var(--brand-text);
    box-shadow: var(--shadow-tile);
  }
  .chip {
    padding: 2px 10px;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--on-ink);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.6;
  }
  .chip.is-back {
    background: var(--tile);
    color: var(--muted);
  }
  .arrow.is-back {
    margin-left: 8px;
  }
  .split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .path {
    display: grid;
    align-content: start;
    gap: 8px;
  }
  .path .node {
    align-self: stretch;
  }
  @container (max-width: 480px) {
    .path .node {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
      padding: 14px;
    }
    .path .link {
      flex-direction: column;
      gap: 4px;
    }
    .arrow.is-back {
      margin: 4px 0 0;
    }
  }
</style>
