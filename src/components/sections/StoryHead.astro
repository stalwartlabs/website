---
import Icon from "../Icon.astro";
import { inlineMd, storyMd } from "../../lib/md";

interface Props {
  data: any;
  id: string;
  nested?: boolean;
}
const { data, id: headingId, nested = false } = Astro.props;
const Heading = nested ? "h3" : "h2";
const { stand, paras } = storyMd(data.body ?? "");
const learnMore: any[] = data.learnMore ?? [];
const hasBody = !!stand || learnMore.length > 0;
---
<div class:list={["story-head reveal", { "is-solo": !hasBody }]}>
  <div class="story-title">
    {data.eyebrow && <span class="pill">{data.eyebrow}</span>}
    <Heading id={headingId} class="h2 h2--feature" set:html={inlineMd(data.title)} />
  </div>
  {hasBody && (
    <div class="story-body section-body">
      {stand && <p class="standfirst" set:html={stand}></p>}
      {paras.map((p) => <p set:html={p}></p>)}
      {learnMore.length > 0 && (
        <p class="more">
          {learnMore.map((cta: any) => (
            <a
              class="text-link"
              href={cta.href}
              {...(cta.external ? { target: "_blank", rel: "noopener" } : {})}
            >{cta.label}<Icon name={cta.external ? "arrow-up-right" : "arrow-right"} size={16} /></a>
          ))}
        </p>
      )}
    </div>
  )}
</div>

<style>
  .story-head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 20px clamp(32px, 6vw, 96px);
    align-items: start;
    margin-bottom: clamp(28px, 3.2vw, 44px);
    padding-inline: clamp(0px, 1.2vw, 16px);
  }
  .story-head.is-solo {
    grid-template-columns: minmax(0, 1fr);
  }
  .story-title {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  .story-title .h2 {
    scroll-margin-top: 72px;
  }
  .story-body {
    display: grid;
    gap: 14px;
    max-width: 62ch;
    padding-top: 4px;
  }
  .story-body p + p {
    margin-top: 0;
  }
  .standfirst {
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--text);
  }
  .more {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    margin-top: 4px;
  }
  @media (max-width: 1023px) {
    .story-head {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
