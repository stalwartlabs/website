---
import { inlineMd, paragraphMd } from "../../lib/md";

interface Props {
  data: any;
}
const { data } = Astro.props;
const hasHead = !!(data.eyebrow || data.title);
const headingId = data.title
  ? `r-${data.title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}`
  : undefined;
---
<section class="wrap section section--prose" aria-labelledby={headingId}>
  <div class:list={["tile prose reveal", { "prose--solo": !hasHead }]}>
    {hasHead && (
      <div class="prose-head">
        {data.eyebrow && <span class="pill">{data.eyebrow}</span>}
        {data.title && <h2 id={headingId} class="h2" set:html={inlineMd(data.title)}></h2>}
      </div>
    )}
    <div class="prose-body" set:html={paragraphMd(data.body)}></div>
  </div>
</section>

<style>
  .prose {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 20px clamp(24px, 5vw, 80px);
    padding: clamp(28px, 4.4vw, 60px);
  }
  .prose--solo {
    grid-template-columns: minmax(0, 1fr);
  }
  .prose--solo .prose-body {
    max-width: 72ch;
  }
  .prose-head {
    display: grid;
    gap: 16px;
    align-content: start;
  }
  .prose-body {
    color: var(--muted);
    font-size: var(--fs-body);
    line-height: 1.65;
  }
  .prose-body :global(p + p) {
    margin-top: 1em;
  }
  .section--prose:nth-child(even of .section--prose) .prose {
    background: var(--rose);
    box-shadow: none;
  }
  .section--prose:nth-child(even of .section--prose) .pill {
    background: var(--tile);
  }
  .section--prose:nth-child(even of .section--prose) .prose-body :global(strong) {
    background: var(--rose-2);
  }
  @media (max-width: 1199px) {
    .prose {
      grid-template-columns: minmax(0, 1fr);
    }
    .prose-head {
      max-width: 760px;
    }
  }
</style>
