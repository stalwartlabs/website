---
import StoryHead from "./StoryHead.astro";
import { paragraphMd, slugify } from "../../lib/md";

interface Props {
  data: any;
  nested?: boolean;
}
const { data, nested = false } = Astro.props;
const headingId = data.title ? `r-${slugify(data.title)}` : undefined;
---
<section class="wrap section section--story" aria-labelledby={headingId}>
  {data.title ? (
    <StoryHead data={data} id={headingId!} nested={nested} />
  ) : (
    <div class="prose-solo reveal">
      {data.eyebrow && <span class="pill">{data.eyebrow}</span>}
      <div class="section-body" set:html={paragraphMd(data.body)}></div>
    </div>
  )}
</section>

<style>
  .prose-solo {
    display: grid;
    gap: 16px;
    justify-items: start;
    max-width: 72ch;
    padding-inline: clamp(0px, 1.2vw, 16px);
  }
</style>
