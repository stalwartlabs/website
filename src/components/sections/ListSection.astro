---
import Icon from "../Icon.astro";
import StoryHead from "./StoryHead.astro";
import { inlineMd, slugify } from "../../lib/md";

interface Props {
  data: any;
  nested?: boolean;
}
const { data, nested = false } = Astro.props;
const headingId = `l-${slugify(data.title)}`;
const RowHeading = nested ? "h4" : "h3";
const bullets: string[] = data.bullets ?? [];
const leadRe = /^\*\*([^*]+?)\*\*\s*/;
const titledRe = /^\*\*[^*]+?[.:]\*\*|^\*\*[^*]+?\*\*[.:]/;
const leads = bullets.filter((b) => leadRe.test(b));
const notes = bullets.filter((b) => !leadRe.test(b));
const rows = leads.length >= 3 && notes.length <= 1 && leads.every((b) => titledRe.test(b));
const rowItems = leads.map((b) => {
  const m = b.match(leadRe)!;
  return { k: m[1].replace(/[.:]$/, ""), v: b.slice(m[0].length).replace(/^[.:]\s*/, "") };
});
const maxLen = Math.max(0, ...bullets.map((b) => b.length));
const cols = bullets.length >= 5 && maxLen <= 140 ? "cols-3" : bullets.length >= 3 ? "cols-2" : "cols-1";
---
<section class="wrap section section--story" aria-labelledby={headingId}>
  <StoryHead data={data} id={headingId} nested={nested} />
  {rows ? (
    <>
      <div class="tile tile--sand rows reveal">
        {rowItems.map((it) => (
          <div class="row">
            <RowHeading class="row-k" set:html={inlineMd(it.k)} />
            <p set:html={inlineMd(it.v)}></p>
          </div>
        ))}
      </div>
      {notes.map((n) => (
        <p class="list-note reveal">
          <Icon name="info" size={18} />
          <span set:html={inlineMd(n)}></span>
        </p>
      ))}
    </>
  ) : (
    <div class="tile tile--sand points reveal">
      <ul class:list={["points-list", cols]}>
        {bullets.map((b) => (
          <li><span class="tick"><Icon name="check" size={13} /></span><span set:html={inlineMd(b)}></span></li>
        ))}
      </ul>
    </div>
  )}
</section>

<style>
  .rows {
    display: grid;
    padding: clamp(8px, 1vw, 12px) clamp(24px, 3vw, 44px);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: 10px clamp(24px, 4vw, 64px);
    padding: clamp(20px, 2.2vw, 30px) 0;
    border-top: 1px solid var(--hairline);
  }
  .row:first-child {
    border-top: 0;
  }
  .row-k {
    font-size: var(--fs-h3);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .row p {
    color: var(--muted);
    max-width: 72ch;
  }
  .points {
    padding: clamp(24px, 2.6vw, 36px);
  }
  .points-list {
    display: grid;
    column-gap: clamp(24px, 3vw, 44px);
    row-gap: 14px;
  }
  .points-list.cols-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .points-list.cols-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .points-list li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: var(--fs-sm);
    line-height: 1.55;
  }
  .row p :global(a),
  .points-list :global(a),
  .list-note :global(a) {
    color: var(--brand-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .list-note {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin-top: var(--gap);
    padding: 18px clamp(20px, 2.6vw, 32px);
    border-radius: var(--r-xl);
    background: var(--rose);
    color: var(--text);
    font-size: var(--fs-sm);
    line-height: 1.55;
  }
  .list-note :global(.i) {
    flex: none;
    margin-top: 2px;
    color: var(--brand-text);
  }
  @media (max-width: 1023px) {
    .row {
      grid-template-columns: 1fr;
    }
    .points-list.cols-3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .points-list.cols-3,
    .points-list.cols-2 {
      grid-template-columns: 1fr;
    }
  }
</style>
