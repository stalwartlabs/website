---
import VisualBlock from "../VisualBlock.astro";
import StoryHead from "./StoryHead.astro";
import Icon from "../Icon.astro";
import { inlineMd, slugify } from "../../lib/md";

interface Props {
  data: any;
  nested?: boolean;
}
const { data, nested = false } = Astro.props;
const headingId = `f-${slugify(data.title)}`;
const bullets: string[] = data.bullets ?? [];
const hasVisual = !!data.visual;
const isShot = data.visual?.kind === "screenshot";
---
<section class="wrap section section--story" aria-labelledby={headingId}>
  <StoryHead data={data} id={headingId} nested={nested} />
  {hasVisual && (
    <div class:list={["media", { "is-reverse": data.reverse, "is-solo": bullets.length === 0, "v-shot": isShot }]}>
      <VisualBlock visual={data.visual} class="media-visual reveal" />
      {bullets.length > 0 && (
        <div class="tile tile--sand points reveal">
          <ul class="points-list">
            {bullets.map((b) => (
              <li><span class="tick"><Icon name="check" size={13} /></span><span set:html={inlineMd(b)}></span></li>
            ))}
          </ul>
        </div>
      )}
    </div>
  )}
  {!hasVisual && bullets.length > 0 && (
    <div class="tile tile--sand points points--wide reveal">
      <ul class:list={["points-list", bullets.length % 3 === 0 || bullets.length > 4 ? "cols-3" : "cols-2"]}>
        {bullets.map((b) => (
          <li><span class="tick"><Icon name="check" size={13} /></span><span set:html={inlineMd(b)}></span></li>
        ))}
      </ul>
    </div>
  )}
</section>

<style>
  .media {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
  }
  .media :global(.media-visual) {
    grid-column: span 7;
    min-width: 0;
    min-height: 100%;
    order: 2;
  }
  .media :global(.media-visual.shot) {
    min-height: 460px;
  }
  .media .points {
    grid-column: span 5;
  }
  .media.is-reverse :global(.media-visual) {
    order: 0;
  }
  .media.is-solo :global(.media-visual) {
    grid-column: 1 / -1;
  }
  .media.is-solo :global(.media-visual.visual-dg > *) {
    width: 100%;
    max-width: 920px;
    margin-inline: auto;
  }
  @media (min-width: 1400px) {
    .media.v-shot :global(.media-visual) {
      grid-column: span 8;
    }
    .media.v-shot .points {
      grid-column: span 4;
    }
    .media.v-shot.is-solo :global(.media-visual) {
      grid-column: 1 / -1;
    }
  }

  .points {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(24px, 2.6vw, 36px);
  }
  .points-list li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 14px 0;
    border-top: 1px solid var(--hairline);
    font-size: var(--fs-sm);
    line-height: 1.55;
  }
  .points-list li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .points-list li:last-child {
    padding-bottom: 0;
  }
  .points-list :global(a) {
    color: var(--brand-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .points--wide .points-list {
    display: grid;
    column-gap: clamp(24px, 3vw, 44px);
    row-gap: 14px;
  }
  .points--wide .points-list.cols-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .points--wide .points-list.cols-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .points--wide .points-list li {
    padding: 0;
    border-top: 0;
  }

  @media (max-width: 1023px) {
    .media :global(.media-visual),
    .media .points {
      grid-column: 1 / -1;
    }
    .media :global(.media-visual) {
      order: 0;
    }
    .points--wide .points-list.cols-3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .media :global(.media-visual.shot) {
      min-height: 340px;
    }
    .points--wide .points-list.cols-3,
    .points--wide .points-list.cols-2 {
      grid-template-columns: 1fr;
    }
  }
</style>
