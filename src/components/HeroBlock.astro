---
import VisualBlock from "./VisualBlock.astro";
import ChapterMap from "./ChapterMap.astro";
import Icon from "./Icon.astro";
import { inlineMd, withHighlight } from "../lib/md";

interface Props {
  hero: any;
  xl?: boolean;
  chapters?: { id: string; title: string; icon: string; summary: string }[];
}
const { hero, xl = false, chapters = [] } = Astro.props;
const titleHtml = hero.titleHighlight ? withHighlight(hero.title.trim(), hero.titleHighlight) : inlineMd(hero.title.trim());
const aside = !hero.visual && hero.aside;
const map = hero.steps?.length
  ? hero.steps
  : chapters.map((c) => ({ title: c.title, icon: c.icon, body: c.summary, href: `#${c.id}` }));
---
<section class:list={["wrap hero", { "hero--xl": xl }]} aria-labelledby="hero-title">
  <div class:list={["hero-grid", { "hero-grid--aside": aside }]}>
    <div class="tile hero-copy reveal">
      {hero.banner && (
        <p class:list={["hero-banner", `hero-banner--${hero.banner.tone}`]}>
          <strong>{hero.banner.label}</strong>
          <span set:html={inlineMd(hero.banner.body)} />
        </p>
      )}
      {hero.eyebrow && <span class="pill">{hero.eyebrow}</span>}
      <h1 id="hero-title" class="display" set:html={titleHtml} />
      {hero.lead && <p class="lead" set:html={inlineMd(hero.lead)} />}
      {(hero.ctas?.length > 0 || hero.meta?.length > 0) && (
        <div class="hero-cta">
          {hero.ctas?.length > 0 && (
            <div class="actions">
              {hero.ctas.map((cta: any, i: number) => (
                <a
                  href={cta.href}
                  class:list={["btn", cta.primary === false ? "btn-soft" : "btn-primary"]}
                  {...(cta.external ? { target: "_blank", rel: "noopener" } : {})}
                >
                  {cta.label}
                  {cta.primary !== false && i === 0 && <Icon name="arrow-right" />}
                </a>
              ))}
            </div>
          )}
          {hero.meta?.length > 0 && (
            <ul class="chips chips--meta" aria-label="Highlights">
              {hero.meta.map((m: string) => (
                <li><Icon name="check" size={14} />{m}</li>
              ))}
            </ul>
          )}
        </div>
      )}
    </div>

    {aside && (
      <div class="tile tile--rose hero-aside reveal">
        <p class="aside-k"><span class="badge"><Icon name="infinity" size={22} /></span>{hero.aside.title}</p>
        <ul class="aside-grid">
          {hero.aside.items.map((it: any) => (
            <li><span class="aside-ic"><Icon name={it.icon} size={18} /></span>{it.label}</li>
          ))}
        </ul>
      </div>
    )}
  </div>

  {hero.visual && <VisualBlock visual={hero.visual} class="hero-visual reveal" full loading="eager" />}
  {map.length > 0 && <ChapterMap items={map} steps={!!hero.steps?.length} />}
</section>

<style>
  .hero {
    padding-top: clamp(16px, 2vw, 28px);
    display: grid;
    gap: var(--gap);
  }
  .hero-grid {
    display: grid;
    gap: var(--gap);
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    padding: clamp(32px, 5vw, 72px);
  }
  .hero-copy h1 {
    font-size: var(--fs-display);
    line-height: 1.05;
    max-width: 22ch;
    overflow-wrap: break-word;
  }
  .hero--xl .hero-copy h1 {
    font-size: var(--fs-display-xl);
  }
  .hero-copy .lead {
    max-width: 64ch;
    margin-top: 4px;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px 28px;
    margin-top: 6px;
  }
  .hero-cta .actions {
    flex-wrap: nowrap;
  }

  .hero :global(.hero-visual.shot) {
    aspect-ratio: 16 / 9;
    min-height: 0;
  }
  .hero :global(.hero-visual.visual-dg svg) {
    max-width: 860px;
    margin-inline: auto;
  }

  .hero-banner {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    width: fit-content;
    padding: 10px 16px;
    border-radius: var(--r-lg);
    background: var(--sand);
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .hero-banner strong {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--brand-text);
  }
  .hero-banner--warn {
    background: var(--rose);
  }
  .hero-banner :global(a) {
    color: var(--brand-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero-grid--aside {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }
  .hero-grid--aside .hero-copy {
    justify-content: center;
  }
  .hero-aside {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .aside-k {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 700;
    letter-spacing: -0.015em;
  }
  .aside-grid {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .aside-grid li {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    padding: 18px;
    border-radius: var(--r-lg);
    background: var(--tile);
    box-shadow: var(--shadow-tile);
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }
  .aside-grid li:first-child {
    grid-column: 1 / -1;
    background: var(--brand);
    color: #fff;
    box-shadow: none;
  }
  .aside-ic {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--rose);
    color: var(--brand-text);
  }
  .aside-grid li:first-child .aside-ic {
    background: rgb(255 255 255 / 0.18);
    color: #fff;
  }

  @media (max-width: 1023px) {
    .hero-grid--aside {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 760px) {
    .hero :global(.hero-visual.shot) {
      aspect-ratio: 4 / 3;
    }
    .hero-cta .actions {
      flex-wrap: wrap;
      width: 100%;
    }
  }
</style>
