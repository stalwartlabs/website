---
import Icon from "./Icon.astro";

const clients = [
  { icon: "laptop", name: "Apple Mail", sub: "macOS / iOS / iPadOS", chips: ["IMAP", "CalDAV"] },
  { icon: "monitor", name: "Outlook", sub: "desktop & mobile", chips: ["IMAP", "Autodiscover"] },
  { icon: "mail", name: "Thunderbird", sub: "Mozilla autoconfig", chips: ["IMAP", "CalDAV"] },
  { icon: "monitor", name: "GNOME Evolution", sub: "Linux desktop", chips: ["IMAP", "CardDAV"] },
  { icon: "smartphone", name: "K-9 Mail / FairEmail", sub: "Android", chips: ["IMAP", "POP3"] },
  { icon: "sparkles", name: "JMAP-native", sub: "modern apps", chips: ["JMAP"], brand: true },
];
---
<div class="dg" role="img" aria-label="Mail clients and the protocols they use with Stalwart: Apple Mail with IMAP and CalDAV, Outlook with IMAP and Autodiscover, Thunderbird with IMAP and CalDAV, GNOME Evolution with IMAP and CardDAV, K-9 Mail and FairEmail with IMAP and POP3, JMAP-native apps with JMAP. Stalwart speaks JMAP, IMAP4rev2, POP3 and ManageSieve.">
  <span class="dg-caption">Every client speaks something Stalwart speaks</span>
  <div class="grid">
    {clients.map((c) => (
      <div class:list={["cell", { "is-brand": c.brand }]}>
        <span class="ic"><Icon name={c.icon} size={18} /></span>
        <strong>{c.name}</strong>
        <span>{c.sub}</span>
        <ul class="mini-chips">{c.chips.map((p) => <li>{p}</li>)}</ul>
      </div>
    ))}
  </div>
  <span class="foot">JMAP · IMAP4rev2 · POP3 · ManageSieve</span>
</div>

<style>
  .dg {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    container-type: inline-size;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  .cell {
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 16px;
    border-radius: var(--r-lg);
    background: var(--tile);
    box-shadow: var(--shadow-tile);
  }
  strong {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 680;
    line-height: 1.3;
  }
  .cell > span:not(.ic) {
    color: var(--muted);
    font-size: var(--fs-xs);
    line-height: 1.45;
  }
  .ic {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: 8px;
    border-radius: 12px;
    background: var(--rose);
    color: var(--brand-text);
  }
  .mini-chips {
    margin-top: 8px;
  }
  .is-brand {
    background: var(--rose);
    box-shadow: none;
  }
  .is-brand .ic {
    background: var(--brand);
    color: #fff;
  }
  .is-brand .mini-chips li {
    background: var(--tile);
    color: var(--brand-text);
  }
  .foot {
    align-self: center;
    max-width: 100%;
    padding: 8px 16px;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--on-ink);
    box-shadow: inset 0 0 0 1px var(--ink-edge);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-align: center;
  }
  @container (max-width: 560px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @container (max-width: 400px) {
    .cell {
      padding: 14px;
    }
    .foot {
      border-radius: var(--r-lg);
    }
  }
  @container (max-width: 240px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
