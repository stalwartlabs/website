---
const stages = ["connect", "EHLO", "AUTH", "MAIL", "RCPT", "DATA"];
const processors = [
  { name: "built-in filter", on: [0, 3, 4, 5] },
  { name: "Sieve", on: [2, 3, 4, 5] },
  { name: "Milter", on: [0, 3, 4, 5] },
  { name: "MTA Hooks", on: [0, 1, 2, 3, 4, 5] },
];
const label = `SMTP stages in order: ${stages.join(", ")}. ${processors
  .map((p) => `${p.name} runs at ${p.on.map((i) => stages[i]).join(", ")}`)
  .join("; ")}.`;
---
<div class="dg" role="img" aria-label={label}>
  <span class="dg-caption">SMTP stages</span>
  <div class="matrix">
    <ol class="stages">
      {stages.map((s) => <li>{s}</li>)}
    </ol>
    {processors.map((p) => (
      <div class="row">
        <strong>{p.name}</strong>
        {stages.map((_, i) => (
          <span class:list={["hook", { "is-on": p.on.includes(i), "is-end": i === stages.length - 1 }]} />
        ))}
      </div>
    ))}
  </div>
</div>

<style>
  .dg {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    container-type: inline-size;
  }
  .matrix {
    display: grid;
    grid-template-columns: minmax(6.5em, auto) repeat(6, minmax(0, 1fr));
    gap: 10px 0;
  }
  .stages {
    position: relative;
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 2 / -1;
    align-items: center;
    padding-inline: 0;
  }
  .stages::before {
    content: "";
    position: absolute;
    inset-inline: calc(100% / 12);
    top: 50%;
    height: 2px;
    border-radius: 1px;
    background: var(--brand);
    opacity: 0.25;
  }
  .stages li {
    position: relative;
    justify-self: center;
    padding: 4px 9px;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--on-ink);
    box-shadow: inset 0 0 0 1px var(--ink-edge);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .row {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    align-items: center;
    padding: 14px 0 14px 16px;
    border-radius: var(--r-lg);
    background: var(--tile);
    box-shadow: var(--shadow-tile);
  }
  .row strong {
    padding-right: 8px;
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 680;
    line-height: 1.3;
  }
  .hook {
    justify-self: center;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px color-mix(in oklab, var(--dim) 40%, transparent);
    background: var(--sand);
  }
  .hook.is-on {
    background: var(--brand);
    box-shadow: none;
  }
  .hook.is-on.is-end {
    box-shadow: 0 0 0 4px var(--rose-2);
  }
  @container (max-width: 440px) {
    .matrix {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .stages {
      grid-column: 1 / -1;
    }
    .stages li {
      padding: 3px 2px;
      background: none;
      box-shadow: none;
      color: var(--text);
      font-size: 0.6875rem;
    }
    .stages::before {
      display: none;
    }
    .row {
      row-gap: 10px;
      padding: 12px 0;
    }
    .row strong {
      grid-column: 1 / -1;
      padding-inline: 14px;
    }
  }
  @container (max-width: 270px) {
    .stages li {
      align-self: end;
      padding: 2px 0;
      writing-mode: vertical-rl;
      transform: rotate(180deg);
    }
  }
</style>
