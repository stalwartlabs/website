---
import { readFileSync } from "node:fs";
import { join } from "node:path";

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 18, class: cls = "" } = Astro.props;
const raw = readFileSync(join(process.cwd(), "node_modules/lucide-static/icons", `${name}.svg`), "utf8");
const inner = raw.slice(raw.indexOf(">", raw.indexOf("<svg")) + 1, raw.lastIndexOf("</svg>"));
---
<svg
  class:list={["i", cls]}
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={inner}
/>
