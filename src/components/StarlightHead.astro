---
import Default from "@astrojs/starlight/components/Head.astro";
import interLatinUrl from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";

const SITE = Astro.site?.toString().replace(/\/$/, "") ?? "https://stalw.art";
const { pathname } = Astro.url;

// Per-blog-post OG image generated by /og/blog/<slug>.png; everything else
// falls back to the shared social card.
const blogMatch = pathname.match(/^\/blog\/(.+?)\/?$/);
let ogImage = `${SITE}/img/stalwart-social-card.jpg`;
if (blogMatch && blogMatch[1] && !/^(authors|tags|\d+)$/.test(blogMatch[1])) {
  ogImage = `${SITE}/og/blog/${blogMatch[1]}.png`;
}

// Pages that shouldn't be indexed:
//  - blog pagination, tags, authors (low-quality duplicates)
const isBlogPagination = /^\/blog\/(\d+|tags|authors)\b/.test(pathname);
const noindex = isBlogPagination;

// Pull JSON-LD blocks declared in page frontmatter via Starlight's `head`
// field is awkward; we expose a structured-data attribute on starlightRoute
// instead. Pages can set `Astro.locals.starlightRoute.entry.data.jsonLd` in
// route middleware, or include their own `<script type="application/ld+json">`
// inline. The shared schemas (Article, BreadcrumbList, FAQPage) are wired in
// by src/components/jsonld/* via this component's slot.

// Build per-page structured data automatically.
const ldBlocks: unknown[] = [];

// BreadcrumbList for every docs page (excluding the docs landing).
if (pathname.startsWith("/docs/") && pathname !== "/docs/" && pathname !== "/docs") {
  const segments = pathname.replace(/\/$/, "").split("/").filter(Boolean);
  const items = segments.map((seg, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: seg
      .replace(/-/g, " ")
      .replace(/\b\w/g, (c) => c.toUpperCase()),
    item: `${SITE}/${segments.slice(0, i + 1).join("/")}/`,
  }));
  ldBlocks.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: items,
  });
}

// Article on every blog post.
const route = (Astro.locals as { starlightRoute?: any }).starlightRoute;
if (
  blogMatch &&
  blogMatch[1] &&
  !/^(authors|tags|\d+)$/.test(blogMatch[1]) &&
  route?.entry?.data
) {
  const data = route.entry.data;
  const date = data.date instanceof Date ? data.date.toISOString() : undefined;
  const lastUpdated =
    data.lastUpdated instanceof Date
      ? data.lastUpdated.toISOString()
      : date;
  const authors = Array.isArray(data.authors) ? data.authors : [];
  ldBlocks.push({
    "@context": "https://schema.org",
    "@type": "Article",
    headline: data.title,
    description: data.description ?? data.excerpt ?? undefined,
    image: ogImage,
    url: `${SITE}${pathname}`,
    ...(date ? { datePublished: date } : {}),
    ...(lastUpdated ? { dateModified: lastUpdated } : {}),
    author: authors.map((a: unknown) =>
      typeof a === "string"
        ? { "@type": "Person", name: a }
        : { "@type": "Person", name: (a as { name?: string }).name ?? "Stalwart" },
    ),
    publisher: {
      "@type": "Organization",
      name: "Stalwart Labs",
      logo: { "@type": "ImageObject", url: `${SITE}/favicon.svg` },
    },
  });
}

function faqPlainText(markdown: string): string {
  return markdown
    .replace(/<!--[\s\S]*?-->/g, "")
    .replace(/`([^`]*)`/g, (_, code: string) => code.replace(/</g, "\u0000").replace(/>/g, "\u0001"))
    .replace(/<[^>]+>/g, "")
    .replace(/\u0000/g, "<")
    .replace(/\u0001/g, ">")
    .replace(/^:::.*$/gm, "")
    .replace(/!?\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/(\*\*|__)(.*?)\1/g, "$2")
    .replace(/\s+/g, " ")
    .trim();
}

function faqAnswers(body: string): { question: string; answer: string }[] {
  const pairs: { question: string; answer: string }[] = [];
  let current: { question: string; lines: string[] } | null = null;
  let inFence = false;
  const flush = () => {
    if (current) {
      pairs.push({ question: current.question, answer: faqPlainText(current.lines.join("\n")) });
      current = null;
    }
  };
  for (const line of body.split("\n")) {
    if (/^\s*(```|~~~)/.test(line)) {
      inFence = !inFence;
      if (current) current.lines.push(line.replace(/^\s*(```|~~~).*/, ""));
      continue;
    }
    const heading = inFence ? null : line.match(/^(#{1,6})\s+(.*)$/);
    if (heading) {
      flush();
      if (heading[1].length === 3) current = { question: heading[2].trim(), lines: [] };
    } else if (current) {
      current.lines.push(line);
    }
  }
  flush();
  return pairs;
}

if (/^\/docs\/faq(\/|$)/.test(pathname) && typeof route?.entry?.body === "string") {
  const headings: { depth: number; slug: string; text: string }[] =
    (route?.headings ?? []).filter((h: { depth: number }) => h.depth === 3);
  const pairs = faqAnswers(route.entry.body);
  if (pairs.length && pairs.length === headings.length && pairs.every((p) => p.answer)) {
    ldBlocks.push({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: pairs.map((p, i) => ({
        "@type": "Question",
        name: headings[i].text,
        acceptedAnswer: {
          "@type": "Answer",
          text: p.answer,
          url: `${SITE}${pathname.replace(/\/$/, "")}/#${headings[i].slug}`,
        },
      })),
    });
  }
}
---
<Default {...Astro.props}><slot /></Default>
<script is:inline>
  (() => {
    try {
      const valid = (v) => v === "light" || v === "dark";
      const site = localStorage.getItem("stalwart-theme");
      const docs = localStorage.getItem("starlight-theme");
      const theme = valid(site) ? site : valid(docs) ? docs : null;
      if (!theme) return;
      document.documentElement.dataset.theme = theme;
      if (site !== theme) localStorage.setItem("stalwart-theme", theme);
      if (docs !== theme) localStorage.setItem("starlight-theme", theme);
    } catch {}
  })();
</script>
{noindex && <meta name="robots" content="noindex"/>}
<link rel="alternate" type="application/rss+xml" title="Stalwart Blog" href="/blog/rss.xml"/>
<link
  rel="preload"
  as="font"
  type="font/woff2"
  href={interLatinUrl}
  crossorigin
/>
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />
{ldBlocks.map((data) => (
  <script type="application/ld+json" set:html={JSON.stringify(data)}/>
))}
