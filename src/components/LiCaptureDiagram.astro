---
import Icon from "./Icon.astro";

const protocols = ["SMTP", "IMAP", "POP3", "JMAP"];
const nodes = ["Node 1", "Node 2", "Node N"];
const label = "Real-time capture: the target's SMTP, IMAP, POP3 and JMAP sessions pass through the Stalwart cluster. An interception point inside each node copies the related data (IRI: who communicated with whom, when, from which address and with what result) and the content (the complete message with its SMTP envelope) to the delivery function. The normal mail flow continues unchanged: no delay, no altered headers and no visible trace.";
---
<div class="dg" role="img" aria-label={label}>
  <span class="dg-caption">Captured inside the server, on every node</span>
  <div class="sessions">
    <span class="lbl">Target's sessions</span>
    <ul class="pills">{protocols.map((p) => <li>{p}</li>)}</ul>
  </div>
  <span class="arrow"><Icon name="arrow-down" size={15} /></span>
  <div class="plate">
    <span class="plate-lbl">Stalwart cluster</span>
    <ul class="nodes">
      {nodes.map((n) => (
        <li>
          <strong>{n}</strong>
          <span class="ip"><Icon name="scan-eye" size={13} />Interception point</span>
        </li>
      ))}
    </ul>
  </div>
  <div class="split">
    <div class="branch">
      <span class="tag">Normal mail flow</span>
      <span class="arrow"><Icon name="arrow-down" size={15} /></span>
      <div class="card card--plain">
        <span class="ic"><Icon name="mail-check" size={16} /></span>
        <div class="body">
          <strong>Unchanged</strong>
          <span class="sub">No delay, no altered headers, no visible trace</span>
        </div>
      </div>
    </div>
    <div class="branch">
      <span class="tag tag--brand">Copy</span>
      <span class="arrow"><Icon name="arrow-down" size={15} /></span>
      <div class="card card--brand">
        <span class="ic"><Icon name="send" size={16} /></span>
        <div class="body">
          <strong>Delivery function</strong>
        </div>
        <dl class="rows">
          <div><dt>Related data (IRI)</dt><dd>Who, with whom, when, from which address, result</dd></div>
          <div><dt>Content</dt><dd>Complete message with its SMTP envelope</dd></div>
        </dl>
      </div>
    </div>
  </div>
</div>

<style>
  .dg {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    container-type: inline-size;
  }
  .sessions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 12px;
  }
  .lbl,
  .plate-lbl {
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 650;
    color: var(--dim);
  }
  .plate-lbl {
    color: var(--brand-text);
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
  }
  .pills li {
    padding: 5px 13px;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--on-ink);
    box-shadow: inset 0 0 0 1px var(--ink-edge);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .arrow {
    display: inline-flex;
    align-self: center;
    color: var(--brand-text);
  }
  .plate {
    display: grid;
    gap: 10px;
    padding: 14px;
    border-radius: var(--r-lg);
    background: var(--rose);
  }
  .nodes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    padding: 0;
  }
  .nodes li {
    display: grid;
    justify-items: start;
    gap: 6px;
    min-width: 0;
    padding: 10px 12px;
    border-radius: 14px;
    background: var(--tile);
    box-shadow: var(--shadow-tile);
  }
  .nodes strong {
    font-size: 0.875rem;
  }
  .ip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    max-width: 100%;
    padding: 3px 9px;
    border-radius: var(--r-pill);
    background: var(--rose);
    color: var(--brand-text);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .ip :global(svg) {
    flex: none;
  }
  .card {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px;
    border-radius: var(--r-lg);
    background: var(--tile);
    box-shadow: var(--shadow-tile);
  }
  .card--brand {
    flex-wrap: wrap;
    align-items: center;
    background: var(--rose);
    box-shadow: none;
  }
  .card--plain {
    background: none;
    box-shadow: inset 0 0 0 1px var(--hairline);
  }
  .body {
    display: grid;
    gap: 6px;
    flex: 1;
    min-width: 0;
  }
  .ic {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: var(--sand);
    color: var(--text);
  }
  .card--brand .ic {
    background: var(--brand);
    color: #fff;
  }
  strong {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 680;
    line-height: 1.3;
    color: var(--text);
  }
  .card--brand strong {
    color: var(--brand-text);
  }
  .sub {
    color: var(--muted);
    font-size: var(--fs-xs);
    line-height: 1.4;
  }
  .rows {
    flex-basis: 100%;
    display: grid;
    gap: 6px;
    margin: 0;
  }
  .rows div {
    display: grid;
    gap: 2px;
    padding: 8px 10px;
    border-radius: 12px;
    background: var(--tile);
  }
  .rows dt {
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
  }
  .rows dd {
    margin: 0;
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.4;
  }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: 10px;
    margin-top: 4px;
  }
  .branch {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .tag {
    align-self: center;
    padding: 3px 11px;
    border-radius: var(--r-pill);
    background: var(--tile);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    text-align: center;
  }
  .tag--brand {
    background: var(--ink);
    color: var(--on-ink);
  }
  @container (max-width: 460px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }
    .nodes {
      grid-template-columns: minmax(0, 1fr);
    }
    .nodes li {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      justify-items: start;
      gap: 10px;
    }
  }
</style>
