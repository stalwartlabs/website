---
import Icon from "./Icon.astro";

const roles = [
  { name: "Mail administrator", icon: "server-cog", can: ["Configure the server"], cannot: "No access to message content" },
  { name: "Compliance investigator", icon: "user-round-search", can: ["Search", "Hold", "Export"], note: "Optional second-person approval for exports", cannot: "Cannot reconfigure the server", brand: true },
  { name: "External auditor", icon: "user-round-check", can: ["View a defined set of data"], window: true, cannot: "Read-only" },
];
const label = "Compliance roles separate from administration: the mail administrator configures the server but has no access to message content; the compliance investigator can search, hold and export, with optional approval of exports by a second person, but cannot reconfigure the server; the external auditor has read-only access to a defined set of data within a time window. Every action by all three roles is written to the audit log.";
---
<div class="dg" role="img" aria-label={label}>
  <span class="dg-caption">Separate roles, one audit log</span>
  <ul class="roles">
    {roles.map((r) => (
      <li class:list={["card", { "card--brand": r.brand }]}>
        <span class="hd"><span class="ic"><Icon name={r.icon} size={16} /></span><strong>{r.name}</strong></span>
        <ul class="can">
          {r.can.map((c) => <li><Icon name="check" size={13} />{c}</li>)}
        </ul>
        {r.note && <span class="note">{r.note}</span>}
        {r.window && <span class="window"><Icon name="clock" size={13} />Time window</span>}
        <span class="cannot"><Icon name="ban" size={13} />{r.cannot}</span>
      </li>
    ))}
  </ul>
  <div class="ticks" aria-hidden="true"><span /><span /><span /></div>
  <div class="log">
    <span class="ic"><Icon name="scroll-text" size={16} /></span>
    <div class="log-body">
      <strong>Audit log</strong>
      <span>Every action, role assignment and item viewed</span>
    </div>
  </div>
</div>

<style>
  .dg {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    container-type: inline-size;
  }
  .roles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    padding: 0;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    padding: 14px;
    border-radius: var(--r-lg);
    background: var(--tile);
    box-shadow: var(--shadow-tile);
  }
  .card--brand {
    background: var(--rose);
    box-shadow: none;
  }
  .hd {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 2px;
  }
  .ic {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: var(--sand);
    color: var(--text);
  }
  .card--brand .ic {
    background: var(--brand);
    color: #fff;
  }
  strong {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 680;
    line-height: 1.3;
    color: var(--text);
  }
  .card--brand strong {
    color: var(--brand-text);
  }
  .can {
    display: grid;
    gap: 4px;
    padding: 0;
  }
  .can li,
  .cannot,
  .window {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    font-size: var(--fs-xs);
    line-height: 1.4;
  }
  .can li {
    color: var(--text);
    font-weight: 550;
  }
  .can :global(svg),
  .cannot :global(svg),
  .window :global(svg) {
    flex: none;
    margin-top: 2px;
  }
  .can :global(svg) {
    color: var(--brand-text);
  }
  .note {
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.4;
  }
  .window {
    align-self: flex-start;
    align-items: center;
    padding: 3px 10px;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--on-ink);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
  }
  .window :global(svg) {
    margin-top: 0;
    color: var(--brand-on-ink);
  }
  .cannot {
    margin-top: auto;
    padding-top: 8px;
    border-top: 1px solid var(--hairline);
    color: var(--dim);
  }
  .ticks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin: -10px 0;
  }
  .ticks span {
    justify-self: center;
    width: 2px;
    height: 18px;
    border-radius: 1px;
    background: var(--brand);
    opacity: 0.35;
  }
  .log {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: var(--r-lg);
    background: var(--ink);
    box-shadow: inset 0 0 0 1px var(--ink-edge);
  }
  .log .ic {
    background: var(--brand);
    color: #fff;
  }
  .log-body {
    display: grid;
    gap: 2px;
  }
  .log strong {
    color: var(--on-ink);
  }
  .log-body span {
    color: var(--on-ink-muted);
    font-size: var(--fs-xs);
    line-height: 1.4;
  }
  @container (max-width: 560px) {
    .roles {
      grid-template-columns: minmax(0, 1fr);
    }
    .hd {
      flex-direction: row;
      align-items: center;
    }
    .ticks {
      grid-template-columns: minmax(0, 1fr);
    }
    .ticks span:not(:first-child) {
      display: none;
    }
  }
</style>
