---
<footer class={`site-footer${hideCta ? " site-footer--no-cta" : ""}`}>
  <div class="wrap">
    {!hideCta && (
      <section class="tile tile--ink cta reveal" aria-labelledby="footer-cta-title">
        <div class="cta-copy">
          <h2 id="footer-cta-title" class="h-cta">{cta}</h2>
          <p class="cta-sub">{ctaSub}</p>
          <div class="actions"><a class="btn btn-on-ink" href="/pricing">See pricing</a></div>
        </div>
        <a class="cta-go" href={ctaLink} {...(ctaLink.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}>
          <span class="cta-go-ic"><Icon name="arrow-up-right" size={24} /></span>
          <span class="cta-go-label">{ctaButton}</span>
        </a>
      </section>
    )}
    <div class="tile tile--sand foot">
      <div class="foot-brand">
        <Logo />
        <address>
          128 City Road<br/>
          London, UK
        </address>
        <a class="text-link" href="mailto:hello@stalw.art">hello@stalw.art</a>
        <ul class="socials">
          {socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={s.path}/>
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <nav class="foot-cols" aria-label="Footer">
        {[
          { title: "Platform", links: platform },
          { title: "Editions", links: editions },
          { title: "Solutions", links: solutions },
          { title: "Company", links: company },
        ].map((col) => (
          <div>
            <h2 class="foot-title">{col.title}</h2>
            <ul>{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          </div>
        ))}
      </nav>
      <div class="foot-bottom">
        <span>&copy; {new Date().getFullYear()} Stalwart Labs. All rights reserved.</span>
        <a href="/legal">Legal</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section);
    padding-bottom: var(--gutter);
  }
  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-footer a:not(.btn, .cta-go) {
    color: inherit;
    text-decoration: none;
  }
  .site-footer .wrap {
    display: grid;
    gap: var(--gap);
  }

  .cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 32px;
    padding: clamp(32px, 5.4vw, 76px);
    isolation: isolate;
  }
  .cta::before {
    content: "";
    position: absolute;
    inset: -40% -10% auto auto;
    width: 70%;
    height: 140%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(219 45 84 / 0.24), transparent);
  }
  .cta-copy {
    display: grid;
    gap: 16px;
    max-width: 640px;
  }
  .h-cta {
    font-size: var(--fs-h2);
    line-height: 1.06;
    letter-spacing: -0.032em;
    font-weight: 740;
    color: var(--on-ink);
  }
  .cta-sub {
    color: var(--on-ink-muted);
    font-size: var(--fs-lead);
  }
  .cta .actions {
    margin-top: 10px;
  }
  .cta-go {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    width: clamp(220px, 22vw, 290px);
    aspect-ratio: 1;
    padding: 28px;
    border-radius: var(--r-xl);
    background: var(--brand);
    color: #fff;
    box-shadow: 0 24px 50px -20px rgb(219 45 84 / 0.75);
    transition: background-color var(--t) var(--ease), transform var(--t) var(--ease), box-shadow var(--t) var(--ease);
  }
  .cta-go:hover {
    background: var(--brand-press);
    transform: translateY(-3px);
    box-shadow: 0 30px 60px -20px rgb(219 45 84 / 0.85);
  }
  .cta-go-ic {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    align-self: flex-end;
    background: rgb(255 255 255 / 0.18);
    transition: transform var(--t) var(--ease);
  }
  .cta-go:hover .cta-go-ic {
    transform: rotate(45deg);
  }
  .cta-go-label {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.25rem);
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .foot {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 32px clamp(24px, 4vw, 64px);
    padding: clamp(28px, 4vw, 52px);
  }
  .foot-brand {
    display: grid;
    gap: 14px;
    align-content: start;
    justify-items: start;
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }
  .socials a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--tile);
    color: var(--muted);
    transition: color var(--t) var(--ease), background-color var(--t) var(--ease);
  }
  .socials a:hover {
    color: #fff;
    background: var(--brand);
  }
  .foot-cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }
  .foot-title {
    margin-bottom: 12px;
    font-size: var(--fs-xs);
    font-weight: 650;
    color: var(--dim);
    letter-spacing: 0.01em;
  }
  .foot-cols ul {
    display: grid;
    gap: 8px;
  }
  .foot-cols a {
    color: var(--text);
    font-size: var(--fs-sm);
    font-weight: 520;
  }
  .foot-cols a:hover {
    color: var(--brand-text);
  }
  .foot-bottom {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 24px;
    margin-top: 8px;
    box-shadow: inset 0 1px 0 var(--hairline);
    color: var(--dim);
    font-size: var(--fs-xs);
  }
  .foot-bottom a:hover {
    color: var(--text);
  }

  @media (pointer: coarse) {
    .foot-cols ul {
      gap: 0;
    }
    .foot-cols a,
    .foot-brand > :global(a),
    .foot-bottom a {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
    }
  }
  @media (max-width: 1023px) {
    .foot {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 760px) {
    .cta {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .cta-copy {
      display: contents;
    }
    .cta-go {
      order: 2;
      width: 100%;
      aspect-ratio: auto;
      flex-direction: row-reverse;
      align-items: center;
      gap: 16px;
      margin-top: 12px;
      padding: 18px 18px 18px 26px;
    }
    .cta-go-ic {
      width: 48px;
      height: 48px;
      flex: none;
    }
    .cta-go-label {
      font-size: 1.375rem;
    }
    .cta .actions {
      order: 3;
      margin-top: 0;
    }
    .foot-cols {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
